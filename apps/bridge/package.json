{
  "name": "@asitha/bridge",
  "version": "0.1.0",
  "private": true,
  "bin": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js start",
    "package": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --out-path ../../native/installers"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": []
  },
  "dependencies": {
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "@asitha/types": "workspace:*",
    "@asitha/protocol": "workspace:*",
    "@asitha/escpos": "workspace:*",
    "@asitha/html": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "ts-node-dev": "^2.0.0"
  }
}
